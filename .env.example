GROQ_API_KEY=your-groq-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
PUBLIC_SITE_URL=http://localhost:3000
LINKEDIN_OAUTH_STATE_SECRET=generate-a-random-secret
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Protects /api/cron/publish. Set the same value in Vercel (Vercel sends it on its own cron runs)
# and in any external scheduler such as cron-job.org, as the header: Authorization: Bearer <value>
CRON_SECRET=generate-a-random-secret
# Only for setups with a once-a-day cron: send Telegram choices this many hours early. Default 0.
CRON_LOOKAHEAD_HOURS=0
